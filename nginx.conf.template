server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location = /healthz {
        default_type text/plain;
        add_header Cache-Control "no-store";
        return 200 "ok\n";
    }

    # Godot keeps stable index.* filenames between releases. Revalidate these
    # files so a new deployment cannot be hidden by an old year-long cache;
    # nginx will still return 304 when the local copy is current.
    location ~ ^/index\.(html|js|wasm|pck)$ {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
